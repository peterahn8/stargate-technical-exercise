<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings, used when collecting "XPlat Code Coverage" with dotnet test (SPEC-4, T12). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Measure the API only, not the tests themselves. -->
          <Include>[StargateAPI]*</Include>
          <!-- EF-generated migrations run in every test via Migrate(), which would inflate coverage. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
